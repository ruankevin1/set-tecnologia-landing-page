---
// A loja inteira numa cena: o caixa no monitor, o celular do garçom e o tablet de mesa à esquerda,
// o celular com o cardápio do delivery e a maquininha aprovando o pagamento enviado pelo caixa.
import type { ImageMetadata } from 'astro';
import Tela from './Tela.astro';
import Maquininha from './Maquininha.astro';
interface Props {
  principal: ImageMetadata; altPrincipal: string;
  tablet: ImageMetadata; altTablet: string;
  celular?: ImageMetadata; altCelular?: string;
  garcom?: ImageMetadata; altGarcom?: string;
  maquininha?: boolean;
  /** Nome da tela da vez trocando embaixo da cena, com a tela correspondente em destaque. */
  vitrine?: boolean;
  prioridade?: boolean;
}
const { principal, altPrincipal, tablet, altTablet, celular, altCelular = '', garcom, altGarcom = '', maquininha = true, vitrine = false, prioridade = false } = Astro.props;
const vez = [
  { nome: 'App do garçom', alvo: 'garcom-pos' }, { nome: 'Caixa e balcão', alvo: 'monitor' }, { nome: 'Tablet de mesa', alvo: 'tablet-pos' },
  { nome: 'Smart TEF', alvo: 'maq-pos' }, { nome: 'Cardápio online', alvo: 'celular-pos' },
];
---
<div class:list={['composicao', { vitrine }]} data-composicao>
  <div class="aura" aria-hidden="true"></div>
  <div class="monitor"><Tela src={principal} alt={altPrincipal} prioridade={prioridade} sizes="(max-width: 1100px) 82vw, 860px" larguras={[640, 960, 1440, 1520]} /><span class="nome-tela" style="--d:.3s">Caixa e balcão</span></div>
  <!-- O tablet desenha a imagem inteira, sem encolher em mais de metade: o texto da tela continua legível. -->
  <div class="tablet-pos"><Tela src={tablet} alt={altTablet} tipo="tablet" sizes="(max-width: 1100px) 34vw, 360px" larguras={[360, 480, 720, 960, 1184]} prioridade={prioridade} /><span class="nome-tela" style="--d:.7s">Tablet de mesa</span></div>
  {celular && <div class="celular-pos"><Tela src={celular} alt={altCelular} tipo="celular" sizes="(max-width: 1100px) 22vw, 230px" larguras={[300, 460, 700]} prioridade={prioridade} /><span class="nome-tela" style="--d:1.1s">Cardápio online</span></div>}
  {garcom && <div class="garcom-pos"><Tela src={garcom} alt={altGarcom} tipo="celular" sizes="(max-width: 1100px) 22vw, 260px" larguras={[300, 520, 738]} prioridade={prioridade} /><span class="nome-tela" style="--d:.5s">App do garçom</span></div>}
  {maquininha && <div class="maq-pos"><Maquininha /><span class="nome-tela" style="--d:.9s">Smart TEF</span></div>}
</div>
{vitrine && (
  <p class="vez" aria-hidden="true" data-vez={JSON.stringify(vez)}><span class="vez-nome">{vez[0].nome}</span></p>
)}

<script>
  // A tela da vez: o nome troca embaixo da cena e a tela correspondente sobe e acende.
  // O mouse manda: a peça embaixo dele vem para a frente e a troca automática espera;
  // ao sair da cena, a troca volta a partir da peça que o mouse deixou.
  document.querySelectorAll<HTMLElement>('[data-vez]').forEach((caixa) => {
    const lista = JSON.parse(caixa.dataset.vez!) as { nome: string; alvo: string }[];
    const cena = caixa.previousElementSibling as HTMLElement;
    const nome = caixa.querySelector<HTMLElement>('.vez-nome')!;
    const parado = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    let troca: number | undefined;
    let giro: number | undefined;
    const focar = () => {
      cena.querySelectorAll('.em-foco').forEach((e) => e.classList.remove('em-foco'));
      cena.querySelector(`.${lista[i].alvo}`)?.classList.add('em-foco');
    };
    const irPara = (j: number) => {
      if (j === i) return;
      i = j; focar();
      clearTimeout(troca);
      nome.classList.add('saindo');
      troca = window.setTimeout(() => { nome.textContent = lista[i].nome; nome.classList.remove('saindo'); }, parado ? 0 : 320);
    };
    const girar = () => {
      clearInterval(giro);
      if (!parado) giro = window.setInterval(() => irPara((i + 1) % lista.length), 2600);
    };
    cena.classList.add('com-foco'); focar(); girar();
    if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    lista.forEach(({ alvo }, j) => {
      cena.querySelector<HTMLElement>(`.${alvo}`)?.addEventListener('pointerenter', () => { clearInterval(giro); irPara(j); });
    });
    cena.addEventListener('pointerleave', girar);
  });
</script>

<style>
  /* Monitor no meio; os dois celulares nas laterais, inteiros; tablet e maquininha na frente, embaixo. */
  .composicao { position: relative; isolation: isolate; padding: 0 17% 15% 11%; margin-bottom: 26px; }
  .composicao:has(.garcom-pos) { padding: 2% 21% 17% 21%; }
  .aura { position: absolute; z-index: -1; inset: 0 5% 10%; border-radius: 50%; background: radial-gradient(closest-side, rgb(243 104 18 / .32), transparent); filter: blur(46px); }
  .tablet-pos { position: absolute; left: 0; bottom: 0; width: 38%; z-index: 2; }
  .composicao:has(.garcom-pos) .tablet-pos { left: 17%; width: 34%; z-index: 4; }
  .garcom-pos { position: absolute; left: 0; top: 0; width: 20%; z-index: 3; animation: boiar 8s ease-in-out -4s infinite; }
  .celular-pos { position: absolute; right: 0; top: 10%; width: 21%; z-index: 3; animation: boiar 7s ease-in-out infinite; }
  .composicao:has(.garcom-pos) .celular-pos { top: 0; width: 20%; }
  .maq-pos { position: absolute; right: 19%; bottom: 3%; width: 13%; z-index: 4; animation: boiar 6s ease-in-out -2s infinite; }
  .composicao:has(.garcom-pos) .maq-pos { right: 22%; width: 11%; bottom: 2%; z-index: 5; }
  /* Nome de cada tela num selo sobre a borda de baixo; o do monitor fica na borda de cima. */
  .monitor, .tablet-pos, .garcom-pos, .celular-pos, .maq-pos { position: relative; }
  .tablet-pos, .garcom-pos, .celular-pos, .maq-pos { position: absolute; }
  .nome-tela {
    position: absolute; left: 50%; bottom: 0; z-index: 6; transform: translate(-50%, 50%);
    white-space: nowrap; padding: 6px 13px; border-radius: 999px; font-size: 13px; font-weight: 600; color: #fff;
    background: var(--laranja); box-shadow: 0 0 0 3px rgb(17 17 16 / .9), 0 8px 22px -6px rgb(243 104 18 / .8);
    animation: selo-entra .55s cubic-bezier(.2,.8,.3,1.3) var(--d, 0s) both;
  }
  .monitor .nome-tela { bottom: auto; top: 0; transform: translate(-50%, -50%); animation-name: selo-entra-cima; }
  @keyframes selo-entra { from { opacity: 0; transform: translate(-50%, 90%) scale(.85); } }
  @keyframes selo-entra-cima { from { opacity: 0; transform: translate(-50%, -10%) scale(.85); } }
  @media (prefers-reduced-motion: reduce) { .nome-tela { animation: none; } }
  /* Tela da vez em destaque: sobe um pouco e o selo pulsa; as outras ficam um pouco mais apagadas. */
  .com-foco > .monitor, .com-foco > .tablet-pos, .com-foco > .garcom-pos, .com-foco > .celular-pos, .com-foco > .maq-pos { transition: filter .5s, scale .5s; }
  .com-foco > :not(.em-foco):not(.aura) { filter: brightness(.72) saturate(.85); }
  .com-foco > .em-foco { scale: 1.035; z-index: 7 !important; }
  .em-foco .nome-tela { animation: pulsar-selo 1.3s ease-in-out infinite; }
  @keyframes pulsar-selo { 50% { box-shadow: 0 0 0 3px rgb(17 17 16 / .9), 0 0 0 9px rgb(243 104 18 / .35), 0 8px 22px -6px rgb(243 104 18 / .9); } }
  .vez { margin-top: 18px; text-align: center; font-size: clamp(26px, 3vw, 38px); font-weight: 600; letter-spacing: -0.03em; }
  .vez-nome { display: inline-block; background: linear-gradient(90deg, #ff8a3d, #f36812, #ffb547); -webkit-background-clip: text; background-clip: text; color: transparent; transition: opacity .3s, transform .3s, filter .3s; }
  .vez-nome.saindo { opacity: 0; transform: translateY(-14px); filter: blur(4px); }
  /* Sem inclinação de rolagem nas peças da frente: ficam nítidas e paradas, só boiando. */
  .composicao :global(.quadro) { animation: none !important; }
  @keyframes boiar { 50% { transform: translateY(-10px); } }
  @media (prefers-reduced-motion: reduce) { .celular-pos, .maq-pos, .garcom-pos { animation: none; } .com-foco > * { filter: none !important; scale: none !important; } }
  /* No celular a cena empilha: o monitor em cima, largo; garçom, maquininha e cardápio embaixo,
     lado a lado e grandes; o tablet some (as telas dele estão na seção própria). */
  @media (max-width: 700px) {
    .composicao, .composicao:has(.garcom-pos) { padding: 0; display: grid; grid-template-columns: 1fr .82fr 1fr; gap: 12px; align-items: end; }
    .garcom-pos :global(.quadro), .celular-pos :global(.quadro) { border-width: 6px; border-radius: 22px; }
    .garcom-pos :global(img), .celular-pos :global(img) { border-radius: 16px; }
    .monitor { grid-column: 1 / -1; }
    .tablet-pos { display: none; }
    .garcom-pos, .celular-pos, .maq-pos,
    .composicao:has(.garcom-pos) .celular-pos, .composicao:has(.garcom-pos) .maq-pos { position: static; width: auto; animation: none; }
    .garcom-pos { grid-column: 1; grid-row: 2; }
    .maq-pos { grid-column: 2; grid-row: 2; padding: 0 10%; }
    .celular-pos { grid-column: 3; grid-row: 2; }
    .garcom-pos, .celular-pos, .maq-pos { position: relative !important; }
    .nome-tela { font-size: 11px; padding: 4px 9px; }
    .composicao, .composicao:has(.garcom-pos) { row-gap: 26px; padding-bottom: 14px; }
  }
</style>
