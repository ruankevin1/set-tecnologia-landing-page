---
// A loja inteira numa cena: o caixa no centro e tudo ligado a ele por cabos com os dados correndo.
// Garçom, tablet, Eduarda, cardápio, 99Food e iFood mandam para o caixa, e o caixa manda para a maquininha.
// No celular, a cena vira uma vitrine que desliza para o lado: um aparelho por vez, grande, na ordem da vez.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Tela from './Tela.astro';
import Maquininha from './Maquininha.astro';
import ConversaMini from './ConversaMini.astro';
import marca99 from '../assets/marcas/noventaenove_food.png';
import marcaIfood from '../assets/marcas/ifood.png';
interface Props {
  principal: ImageMetadata; altPrincipal: string;
  tablet: ImageMetadata; altTablet: string;
  celular: ImageMetadata; altCelular?: string;
  garcom: ImageMetadata; altGarcom?: string;
  /** Nome da tela da vez trocando embaixo da cena, com a tela correspondente em destaque. */
  vitrine?: boolean;
  prioridade?: boolean;
}
const { principal, altPrincipal, tablet, altTablet, celular, altCelular = '', garcom, altGarcom = '', vitrine = false, prioridade = false } = Astro.props;
const vez = [
  { nome: 'App do garçom', alvo: 'garcom-pos' }, { nome: 'Caixa e balcão', alvo: 'monitor' }, { nome: 'Tablet de mesa', alvo: 'tablet-pos' },
  { nome: 'Smart TEF', alvo: 'maq-pos' }, { nome: 'Cardápio online', alvo: 'celular-pos' }, { nome: 'Eduarda no WhatsApp', alvo: 'setia-pos' },
];
// Cada cabo começa em quem envia e termina em quem recebe: é o sentido em que o dado corre.
// As pontas entram por baixo dos aparelhos. Coordenadas no palco de cada tamanho de tela.
const cabosComputador = [
  'M140 180 H310', // garçom
  'M940 88 H870', // 99Food
  'M940 214 H870', // iFood
  'M1040 280 H870', // cardápio
  'M590 470 V320', // tablet
  'M310 470 H360 Q372 470 372 458 V320', // Eduarda
  'M850 320 V358 Q850 370 862 370 H891 Q903 370 903 382 V430', // caixa para a maquininha
];
const cabosCelular = [
  'M56 225 V300', // garçom
  'M180 225 V300', // Eduarda
  'M304 225 V300', // cardápio
  'M21 545 V455', // 99Food
  'M63 545 V455', // iFood
  'M180 525 V455', // tablet
  'M325 455 V530', // caixa para a maquininha
];
---
<div class:list={['composicao', { vitrine }]} data-composicao>
  <div class="aura" aria-hidden="true"></div>
  <svg class="cabos cabos-computador" viewBox="0 0 1180 700" aria-hidden="true">
    {cabosComputador.map((d) => <path class="cabo" d={d} />)}
    {cabosComputador.map((d, i) => <path class="dado" d={d} pathLength="100" style={`--atraso:${i * -0.37}s`} />)}
  </svg>
  <svg class="cabos cabos-celular" viewBox="0 0 360 665" aria-hidden="true">
    {cabosCelular.map((d) => <path class="cabo" d={d} />)}
    {cabosCelular.map((d, i) => <path class="dado" d={d} pathLength="100" style={`--atraso:${i * -0.37}s`} />)}
  </svg>
  <div class="monitor"><Tela src={principal} alt={altPrincipal} prioridade={prioridade} sizes="(max-width: 700px) 100vw, (max-width: 1180px) 60vw, 860px" larguras={[640, 960, 1440, 1520]} /><span class="nome-tela" style="--d:.3s">Caixa e balcão</span></div>
  <!-- O tablet desenha a imagem inteira, sem encolher em mais de metade: o texto da tela continua legível. -->
  <div class="tablet-pos"><Tela src={tablet} alt={altTablet} tipo="tablet" sizes="(max-width: 700px) 80vw, (max-width: 1180px) 48vw, 560px" larguras={[360, 480, 720, 960, 1184]} prioridade={prioridade} /><span class="nome-tela" style="--d:.7s">Tablet de mesa</span></div>
  <div class="celular-pos"><Tela src={celular} alt={altCelular} tipo="celular" sizes="(max-width: 700px) 54vw, (max-width: 1180px) 26vw, 300px" larguras={[300, 460, 700]} prioridade={prioridade} /><span class="nome-tela" style="--d:1.1s">Cardápio online</span></div>
  <div class="garcom-pos"><Tela src={garcom} alt={altGarcom} tipo="celular" sizes="(max-width: 700px) 54vw, (max-width: 1180px) 26vw, 300px" larguras={[300, 520, 738]} prioridade={prioridade} /><span class="nome-tela" style="--d:.5s">App do garçom</span></div>
  <div class="setia-pos"><ConversaMini /><span class="nome-tela" style="--d:1.3s">Eduarda no WhatsApp</span></div>
  <div class="maq-pos"><Maquininha /><span class="nome-tela" style="--d:.9s">Smart TEF</span></div>
  <Image class="app app-99" src={marca99} alt="99Food" widths={[64, 96, 128]} sizes="64px" format="png" />
  <Image class="app app-ifood" src={marcaIfood} alt="iFood" widths={[64, 96, 128]} sizes="64px" format="png" />
</div>
{vitrine && (
  <p class="vez" aria-hidden="true" data-vez={JSON.stringify(vez)}><span class="vez-nome">{vez[0].nome}</span></p>
)}
<div class="pontos">{vez.map((v, j) => <button type="button" aria-label={`Mostrar ${v.nome}`} class:list={{ atual: j === 0 }}></button>)}</div>

<script>
  // A tela da vez: o nome troca embaixo da cena e o selo da tela correspondente pulsa.
  // O mouse manda: só a peça embaixo dele vem para a frente, e a troca automática espera;
  // ao sair da cena, as peças voltam ao lugar e a troca continua a partir da última.
  // No celular, a vez também rola a vitrine até o aparelho dela; quem desliza com o dedo ou toca num ponto
  // escolhe a vez, e a troca automática espera.
  document.querySelectorAll<HTMLElement>('[data-vez]').forEach((caixa) => {
    const lista = JSON.parse(caixa.dataset.vez!) as { nome: string; alvo: string }[];
    const cena = caixa.previousElementSibling as HTMLElement;
    const nome = caixa.querySelector<HTMLElement>('.vez-nome')!;
    const pontos = [...(caixa.nextElementSibling?.querySelectorAll<HTMLElement>('button') ?? [])];
    const pecas = lista.map(({ alvo }) => cena.querySelector<HTMLElement>(`.${alvo}`)!);
    const parado = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const celular = matchMedia('(max-width: 700px)');
    let i = 0;
    let troca: number | undefined;
    let giro: number | undefined;
    let volta: number | undefined;
    const focar = () => {
      cena.querySelectorAll('.em-foco').forEach((e) => e.classList.remove('em-foco'));
      pecas[i].classList.add('em-foco');
      pontos.forEach((p, j) => p.classList.toggle('atual', j === i));
    };
    const centralizar = () => {
      if (!celular.matches) return;
      const p = pecas[i];
      cena.scrollTo({ left: p.offsetLeft - (cena.clientWidth - p.offsetWidth) / 2, behavior: parado ? 'auto' : 'smooth' });
    };
    const irPara = (j: number, rolar = true) => {
      if (j === i) return;
      i = j; focar();
      if (rolar) centralizar();
      clearTimeout(troca);
      nome.classList.add('saindo');
      troca = window.setTimeout(() => { nome.textContent = lista[i].nome; nome.classList.remove('saindo'); }, parado ? 0 : 320);
    };
    const girar = () => {
      clearInterval(giro);
      if (!parado) giro = window.setInterval(() => irPara((i + 1) % lista.length), celular.matches ? 3400 : 2600);
    };
    const esperar = () => { clearInterval(giro); clearTimeout(volta); volta = window.setTimeout(girar, 7000); };
    cena.classList.add('com-foco'); focar(); girar();
    pontos.forEach((p, j) => p.addEventListener('click', () => { esperar(); irPara(j); }));
    cena.addEventListener('touchstart', esperar, { passive: true });
    let soltou: number | undefined;
    cena.addEventListener('scroll', () => {
      if (!celular.matches) return;
      clearTimeout(soltou);
      soltou = window.setTimeout(() => {
        const meio = cena.scrollLeft + cena.clientWidth / 2;
        let perto = i, menor = Infinity;
        pecas.forEach((p, j) => { const d = Math.abs(p.offsetLeft + p.offsetWidth / 2 - meio); if (d < menor) { menor = d; perto = j; } });
        irPara(perto, false);
      }, 120);
    }, { passive: true });
    if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    let topo = 10;
    pecas.forEach((peca, j) => peca.addEventListener('pointerenter', () => {
      clearInterval(giro); irPara(j);
      pecas.forEach((p) => p.classList.toggle('sob-mouse', p === peca));
      peca.style.zIndex = String(++topo);
    }));
    cena.addEventListener('pointerleave', () => {
      girar();
      pecas.forEach((p) => { p.classList.remove('sob-mouse'); p.style.removeProperty('z-index'); });
    });
  });
</script>

<style>
  /* Palco de proporção fixa: o caixa no centro e as peças em volta, em %, com espaço para os cabos.
     As peças ficam paradas: movimento contínuo faz o navegador desenhar a tela como textura e borra letra e foto. */
  .composicao { position: relative; isolation: isolate; aspect-ratio: 1180 / 700; margin-bottom: 26px; }
  .aura { position: absolute; z-index: -1; inset: 0 5% 10%; border-radius: 50%; background: radial-gradient(closest-side, rgb(243 104 18 / .32), transparent); filter: blur(46px); }
  .monitor, .tablet-pos, .garcom-pos, .celular-pos, .maq-pos, .setia-pos, .app { position: absolute; }
  .monitor { left: 25%; top: 2.9%; width: 50%; z-index: 2; }
  .garcom-pos { left: 0; top: 2.9%; width: 13.5%; z-index: 3; }
  .celular-pos { right: 0; top: 2.9%; width: 13.5%; z-index: 3; }
  .setia-pos { left: 14.5%; top: 50%; width: 13.5%; z-index: 3; }
  .tablet-pos { left: 35%; top: 64%; width: 30%; z-index: 3; }
  .maq-pos { left: 71%; top: 57%; width: 11%; z-index: 3; }
  .app { left: 78.5%; width: 5.4%; height: auto; z-index: 3; filter: drop-shadow(0 10px 14px rgb(0 0 0 / .7)); }
  .app-99 { top: 8%; }
  .app-ifood { top: 26%; }
  /* Os três celulares com a mesma altura: o cardápio, mais curto, completa com o fundo escuro do aparelho. */
  .garcom-pos :global(.quadro), .celular-pos :global(.quadro) { aspect-ratio: 756 / 1615; }
  /* Celulares de moldura fina: borda preta estreita, um aro metálico fino por fora e a sombra. */
  .composicao .garcom-pos :global(.quadro), .composicao .celular-pos :global(.quadro), .composicao .setia-pos :global(.aparelho) {
    border: 4px solid #0a0a09; border-radius: 24px;
    box-shadow: 0 0 0 1.5px #4a463f, 0 0 0 2.5px #161513, 0 30px 60px -30px rgb(0 0 0 / .9); }
  .composicao .garcom-pos :global(.quadro img), .composicao .celular-pos :global(.quadro img) { border-radius: 20px; }

  /* Cabos embaixo dos aparelhos, com um pulso de dado correndo de quem envia para quem recebe. */
  .cabos { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .cabos-celular { display: none; }
  .cabos path { fill: none; stroke-linecap: round; }
  .cabo { stroke: #3a3631; stroke-width: 4; }
  .dado { stroke: #ff8a3d; stroke-width: 3; stroke-dasharray: 9 91; stroke-dashoffset: 100; filter: drop-shadow(0 0 4px rgb(243 104 18 / .9)); animation: dado-corre 2.6s linear var(--atraso, 0s) infinite; }
  @keyframes dado-corre { to { stroke-dashoffset: 0; } }

  /* Nome de cada tela num selo sobre a borda de baixo; o do monitor fica na borda de cima. */
  .nome-tela {
    position: absolute; left: 50%; bottom: 0; z-index: 6; transform: translate(-50%, 50%);
    white-space: nowrap; padding: 6px 13px; border-radius: 999px; font-size: 13px; font-weight: 600; color: var(--sobre-laranja);
    background: var(--laranja); box-shadow: 0 0 0 3px rgb(17 17 16 / .9), 0 8px 22px -6px rgb(243 104 18 / .8);
    animation: selo-entra .55s cubic-bezier(.2,.8,.3,1.3) var(--d, 0s) both;
  }
  .monitor .nome-tela { bottom: auto; top: 0; transform: translate(-50%, -50%); animation-name: selo-entra-cima; }
  @keyframes selo-entra { from { opacity: 0; transform: translate(-50%, 90%) scale(.85); } }
  @keyframes selo-entra-cima { from { opacity: 0; transform: translate(-50%, -10%) scale(.85); } }

  /* A tela da vez só pulsa o selo. Quem cresce é a peça sob o mouse, e ela volta nítida ao parar. */
  .com-foco > .monitor, .com-foco > .tablet-pos, .com-foco > .garcom-pos, .com-foco > .celular-pos, .com-foco > .maq-pos, .com-foco > .setia-pos { transition: scale .3s; }
  .com-foco > .sob-mouse { scale: 1.08; }
  .em-foco .nome-tela { animation: pulsar-selo 1.3s ease-in-out infinite; }
  @keyframes pulsar-selo { 50% { box-shadow: 0 0 0 3px rgb(17 17 16 / .9), 0 0 0 9px rgb(243 104 18 / .35), 0 8px 22px -6px rgb(243 104 18 / .9); } }
  .vez { margin-top: 18px; text-align: center; font-size: clamp(26px, 3vw, 38px); font-weight: 600; letter-spacing: -0.03em; }
  .vez-nome { display: inline-block; background: linear-gradient(90deg, #ff8a3d, #f36812, #ffb547); -webkit-background-clip: text; background-clip: text; color: transparent; transition: opacity .3s, transform .3s, filter .3s; }
  .vez-nome.saindo { opacity: 0; transform: translateY(-14px); filter: blur(4px); }
  .pontos { display: none; }
  /* Sem inclinação de rolagem nas peças da cena. */
  .composicao :global(.quadro) { animation: none !important; }
  @media (prefers-reduced-motion: reduce) {
    .nome-tela { animation: none; }
    .dado { animation: none; opacity: 0; }
    .com-foco > * { scale: none !important; }
  }

  /* No celular, a vitrine: os aparelhos lado a lado numa faixa que desliza, um por vez no centro e o vizinho
     aparecendo na beirada. Sem cabos, sem os logos dos apps e sem o nome grande embaixo: o selo de cada aparelho
     diz qual é, e os pontos mostram onde se está. */
  @media (max-width: 700px) {
    .composicao { aspect-ratio: auto; display: flex; align-items: center; gap: 18px; margin-inline: -16px; padding: 6px 14% 18px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
    .composicao::-webkit-scrollbar { display: none; }
    .aura, .cabos, .app, .vez { display: none; }
    .monitor, .tablet-pos, .garcom-pos, .celular-pos, .maq-pos, .setia-pos { position: relative; inset: auto; flex: 0 0 100%; z-index: 1; display: flex; flex-direction: column; align-items: center; scroll-snap-align: center; }
    /* As telas largas ocupam quase a tela toda; os celulares deixam o vizinho aparecer. */
    .monitor, .tablet-pos { flex-basis: 124%; }
    .garcom-pos { order: 1; } .monitor { order: 2; } .tablet-pos { order: 3; } .maq-pos { order: 4; } .celular-pos { order: 5; } .setia-pos { order: 6; }
    .garcom-pos > :global(:first-child), .celular-pos > :global(:first-child), .setia-pos > :global(:first-child) { width: min(210px, 74%); }
    .monitor > :global(:first-child), .tablet-pos > :global(:first-child) { width: 100%; }
    .maq-pos > :global(:first-child) { width: min(140px, 50%); }
    .nome-tela, .monitor .nome-tela { position: static; transform: none; margin-top: 16px; font-size: 13px; animation: none; }
    .em-foco .nome-tela { animation: pulsar-selo 1.3s ease-in-out infinite; }
    .composicao .garcom-pos :global(.quadro), .composicao .celular-pos :global(.quadro), .composicao .setia-pos :global(.aparelho) { border-width: 5px; border-radius: 30px; }
    .composicao .garcom-pos :global(.quadro img), .composicao .celular-pos :global(.quadro img) { border-radius: 25px; }
    .tablet-pos :global(.quadro) { border-width: 8px; border-radius: 18px; }
    .tablet-pos :global(img) { border-radius: 10px; }
    .pontos { display: flex; justify-content: center; gap: 4px; margin-top: 2px; }
    .pontos button { width: 28px; height: 28px; padding: 0; border: 0; background: none; cursor: pointer; display: grid; place-items: center; }
    .pontos button::after { content: ''; width: 7px; height: 7px; border-radius: 99px; background: rgb(255 255 255 / .25); transition: width .3s, background .3s; }
    .pontos button.atual::after { width: 22px; background: var(--laranja); }
  }

</style>
