---
interface Props { itens: { p: string; r: string }[]; titulo?: string }
const { itens, titulo = 'Perguntas frequentes' } = Astro.props;
---
<section class="perguntas envelope" aria-labelledby="perguntas-titulo">
  <div class="lado">
    <p class="rotulo">Dúvidas</p>
    <h2 id="perguntas-titulo" class="titulo-secao">{titulo}</h2>
  </div>
  <div class="lista">
    {itens.map((i) => (
      <details data-luz>
        <summary>{i.p}<span class="sinal" aria-hidden="true"></span></summary>
        <p>{i.r}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .perguntas { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 48px; padding-block: clamp(72px, 10vw, 128px); }
  .lado h2 { margin-top: 14px; font-size: clamp(30px, 3.6vw, 42px); }
  .lista { display: grid; gap: 10px; }
  details { border: 1px solid var(--linha); border-radius: 14px; background: linear-gradient(180deg, #181715, #131211); padding-inline: 22px; }
  details[open] { border-color: rgb(243 104 18 / .4); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 24px;
    padding: 22px 0; font-size: 19px; font-weight: 500; letter-spacing: -0.01em;
  }
  summary::-webkit-details-marker { display: none; }
  .sinal { position: relative; width: 14px; height: 14px; flex: none; }
  .sinal::before, .sinal::after { content: ''; position: absolute; inset: 6px 0 auto; height: 1.6px; background: currentColor; transition: transform .2s; }
  .sinal::after { transform: rotate(90deg); }
  details[open] .sinal::after { transform: rotate(0deg); }
  details p { padding: 0 0 24px; color: var(--tinta-2); max-width: 62ch; }
  @media (max-width: 860px) { .perguntas { grid-template-columns: 1fr; gap: 28px; } }
</style>
