---
// Chamada final em faixa laranja com estrelas: leva ao formulário (#contato), o canal principal de contato.
import Estrelas from './Estrelas.astro';
import Icone from './Icone.astro';
interface Props { titulo?: string; texto?: string; alvo?: string }
const {
  titulo = 'Pronto para organizar o salão, a cozinha e o delivery?',
  texto = 'Uma conversa de 15 minutos e a configuração indicada para a sua operação, sem compromisso.',
  alvo = '#contato',
} = Astro.props;
---
<section class="chamada envelope" data-revelar>
  <div class="caixa" data-luz>
    <Estrelas />
    <h2>{titulo}</h2>
    <p>{texto}</p>
    <div class="acoes">
      <a class="botao botao-principal" href={alvo}>Falar com especialista <Icone nome="seta" /></a>
    </div>
  </div>
</section>

<style>
  .chamada { padding-block: clamp(40px, 6vw, 72px); }
  .caixa { position: relative; isolation: isolate; overflow: hidden; text-align: center; padding: clamp(44px, 7vw, 88px) clamp(20px, 5vw, 64px); border-radius: 24px; border: 1px solid rgb(243 104 18 / .35);
    background: radial-gradient(80% 120% at 50% 0%, rgb(243 104 18 / .30), transparent 60%), #15110d; }
  .caixa > :not(canvas) { position: relative; z-index: 1; }
  h2 { font-size: clamp(30px, 4vw, 50px); max-width: 22ch; margin-inline: auto; }
  p { margin: 16px auto 0; color: var(--tinta-2); max-width: 52ch; }
  .acoes { margin-top: 30px; display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
</style>
