---
// Abertura das páginas internas: texto e quatro vantagens à esquerda, formulário à direita (o canal principal);
// a tela do sistema (slot) vem logo abaixo, larga.
import Estrelas from './Estrelas.astro';
import IconeModulo, { type NomeModulo } from './IconeModulo.astro';
import Formulario from './Formulario.astro';
interface Props { rotulo: string; titulo: string; texto: string; selos?: { icone: NomeModulo; t: string }[]; cidade?: string; centro?: boolean; migalhas?: { nome: string; href: string }[] }
const { rotulo, titulo, texto, selos = [], cidade = '', centro = false, migalhas = [] } = Astro.props;
---
<section class:list={['topo-produto', { centro }]}>
  <Estrelas />
  {migalhas.length > 0 && (
    <nav class="envelope migalhas" aria-label="Você está em">
      <a href="/">Início</a>
      {migalhas.map((m, i) => (<><span aria-hidden="true">/</span>{i === migalhas.length - 1 ? <span aria-current="page">{m.nome}</span> : <a href={m.href}>{m.nome}</a>}</>))}
    </nav>
  )}
  <div class="envelope dentro">
    <div class="texto">
      <p class="rotulo entra">{rotulo}</p>
      <h1 class="entra" style="--atraso:.06s" set:html={titulo} />
      <p class="lead entra" style="--atraso:.12s">{texto}</p>
      {selos.length > 0 && (
        <ul class="selos entra" style="--atraso:.18s">
          {selos.map((s) => <li data-luz><span class="ico-selo"><IconeModulo nome={s.icone} /></span>{s.t}</li>)}
        </ul>
      )}
    </div>
    <div class="form entra" style="--atraso:.2s" id="contato"><Formulario cidade={cidade} /></div>
  </div>
  {Astro.slots.has('default') && <div class="envelope visual" data-revelar><slot /></div>}
</section>

<style>
  .topo-produto { position: relative; isolation: isolate; overflow-x: clip; overflow-y: visible; margin-top: -76px; padding-top: 76px;
    background: radial-gradient(55% 60% at 80% 45%, rgb(243 104 18 / .13), transparent 70%), radial-gradient(40% 40% at 10% 10%, rgb(255 90 43 / .06), transparent 70%); }
  .migalhas { position: relative; z-index: 1; display: flex; gap: 10px; flex-wrap: wrap; padding-top: 30px; font-family: var(--mono); font-size: 12.5px; color: var(--tinta-3); }
  .migalhas a { text-decoration: none; }
  .migalhas a:hover { color: var(--tinta); }
  .centro .migalhas { justify-content: center; }
  /* Acima da tela que vem embaixo: a lista dos seletores do formulário abre por cima dela. */
  .dentro { position: relative; z-index: 3; display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(32px, 5vw, 72px); align-items: center; padding-block: clamp(28px, 4vw, 56px) clamp(48px, 6vw, 80px); }
  .centro .dentro { grid-template-columns: 1fr; text-align: center; justify-items: center; }
  .centro .lead { margin-inline: auto; }
  .centro .selos { justify-content: center; }
  .form { scroll-margin-top: 96px; }
  h1 { margin-top: 18px; font-size: clamp(36px, 4.6vw, 60px); letter-spacing: -0.04em; line-height: 1.03; }
  h1 :global(em) { font-style: normal; background: linear-gradient(90deg, #ff8a3d, #f36812, #ffb547, #ff5a2b, #ff8a3d); background-size: 300% 100%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: correr-cor 8s linear infinite; }
  @keyframes correr-cor { to { background-position: 300% 0; } }
  .lead { margin-top: 20px; }
  .selos { list-style: none; margin-top: 26px; display: grid; grid-template-columns: repeat(2, minmax(0, max-content)); gap: 10px; }
  .centro .selos { display: flex; flex-wrap: wrap; }
  .selos li { display: flex; align-items: center; gap: 10px; padding: 9px 14px 9px 9px; border-radius: 10px; font-size: 14.5px; font-weight: 500; background: rgb(255 255 255 / .04); border: 1px solid var(--linha-forte); }
  .ico-selo { width: 28px; height: 28px; border-radius: 8px; display: grid; place-items: center; background: rgb(243 104 18 / .16); color: var(--laranja-claro); flex: none; }
  .ico-selo :global(.ico) { width: 16px; height: 16px; }
  .visual { position: relative; z-index: 1; padding-bottom: clamp(48px, 7vw, 96px); }
  @media (prefers-reduced-motion: reduce) { h1 :global(em) { animation: none; } }
  @media (max-width: 1000px) { .dentro { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .selos { grid-template-columns: 1fr; } }
</style>
