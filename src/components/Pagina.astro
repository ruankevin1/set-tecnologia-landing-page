---
// Abertura padrão das páginas internas: rótulo, título, texto e ações.
import Icone from './Icone.astro';
interface Props { rotulo: string; titulo: string; texto: string; mensagem?: string }
const { rotulo, titulo, texto, mensagem } = Astro.props;
---
<section class="topo envelope">
  <p class="rotulo entra">{rotulo}</p>
  <h1 class="entra" style="--atraso:.08s" set:html={titulo} />
  <p class="lead entra" style="--atraso:.16s">{texto}</p>
  <div class="acoes entra" style="--atraso:.24s">
    <a class="botao botao-principal" href="#contato">Falar com especialista <Icone nome="seta" /></a>
    <slot name="acao" />
  </div>
  <slot />
</section>

<style>
  .topo { padding-block: clamp(36px, 6vw, 72px) clamp(40px, 6vw, 72px); }
  h1 { margin-top: 20px; font-size: clamp(38px, 5.4vw, 68px); letter-spacing: -0.035em; line-height: 1.03; max-width: 17ch; }
  .lead { margin-top: 22px; }
  .acoes { margin-top: 32px; display: flex; gap: 12px; flex-wrap: wrap; }
  h1 :global(em) { font-style: normal; color: var(--laranja); }
</style>
