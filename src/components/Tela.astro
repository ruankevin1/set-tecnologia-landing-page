---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
// Print real do sistema numa moldura discreta (a barra do Windows já vem no próprio print).
// PNG e sempre com a largura original entre as opções: letra de tela não aguenta compressão com perda.
interface Props { src: ImageMetadata; alt: string; legenda?: string; prioridade?: boolean; tipo?: 'janela' | 'celular' | 'tablet'; rolar?: boolean; larguras?: number[]; sizes?: string }
const { src, alt, legenda, prioridade = false, tipo = 'janela', rolar = false, larguras = [640, 960, 1440, 1920], sizes = '(max-width: 1240px) 100vw, 1200px' } = Astro.props;
---
<figure class:list={['tela', tipo, { rolar }]}>
  <div class="quadro">
    <Image
      src={src}
      alt={alt}
      widths={[...new Set([...larguras.filter((w) => w < src.width), src.width])]}
      sizes={sizes}
      format="png"
      loading={prioridade ? 'eager' : 'lazy'}
      fetchpriority={prioridade ? 'high' : undefined}
    />
  </div>
  {legenda && <figcaption>{legenda}</figcaption>}
</figure>

<style>
  .tela { margin: 0; }
  /* Monitor: moldura escura com borda clara em cima, brilho laranja atrás e sombra longa. */
  .janela .quadro {
    position: relative; padding: clamp(5px, .7vw, 9px); border-radius: clamp(10px, 1.2vw, 16px); overflow: hidden;
    background: linear-gradient(180deg, #2b2825, #161513);
    box-shadow: 0 0 0 1px rgb(255 255 255 / .12), inset 0 1px 0 rgb(255 255 255 / .14),
      0 50px 90px -40px rgb(0 0 0 / .95), 0 0 90px -30px rgb(243 104 18 / .45);
  }
  .janela .quadro :global(img) { border-radius: clamp(5px, .6vw, 8px); }
  /* Reflexo diagonal discreto por cima da tela. */
  .janela .quadro::after { content: ''; position: absolute; inset: 0; pointer-events: none; border-radius: inherit;
    background: linear-gradient(115deg, rgb(255 255 255 / .07) 0%, transparent 28%); }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 761px) {
      .janela .quadro { animation: endireitar linear both; animation-timeline: view(); animation-range: entry 0% cover 40%; transform-origin: 50% 100%; }
      @keyframes endireitar { from { transform: perspective(1600px) rotateX(12deg) scale(.94); opacity: .5; } to { transform: none; opacity: 1; } }
    }
  }
  .celular .quadro {
    border: 9px solid #26241f;
    border-radius: 34px;
    overflow: hidden;
    background: #141412;
    box-shadow: 0 0 0 1px rgb(255 255 255 / .12), 0 30px 60px -30px rgb(0 0 0 / .9);
  }
  .celular .quadro :global(img) { border-radius: 25px; }
  .tablet .quadro { border: 12px solid #1f1e1c; border-radius: 26px; overflow: hidden; background: #1f1e1c;
    box-shadow: 0 0 0 1px rgb(255 255 255 / .14), inset 0 1px 0 rgb(255 255 255 / .1), 0 40px 80px -30px rgb(0 0 0 / .95), 0 0 80px -30px rgb(243 104 18 / .4); }
  .tablet .quadro :global(img) { border-radius: 10px; }
  @media (max-width: 760px) {
    .rolar .quadro { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .rolar .quadro :global(img) { width: 900px; max-width: none; }
    .rolar::after { content: 'Arraste para o lado para ver a tela inteira'; display: block; margin-top: 10px; font-family: var(--mono); font-size: 12px; color: var(--tinta-3); }
  }
  figcaption { margin-top: 14px; font-size: 14px; color: var(--tinta-3); text-align: center; }
</style>
