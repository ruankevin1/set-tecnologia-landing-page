---
// Maquininha smart desenhada (sem marca): recebe o valor do caixa, processa e mostra "Aprovado", em ciclo.
interface Props { valor?: string }
const { valor = 'R$ 98,00' } = Astro.props;
---
<div class="maquininha" role="img" aria-label={`Maquininha smart recebendo ${valor} enviado pelo caixa e aprovando o pagamento`}>
  <span class="impressora" aria-hidden="true"><span class="papel"></span></span>
  <div class="tela" aria-hidden="true">
    <p class="topo">Crédito à vista</p>
    <p class="valor">{valor}</p>
    <div class="estados">
      <p class="e1"><span class="cartao"></span>Aproxime o cartão</p>
      <p class="e2"><span class="roda"></span>Processando</p>
      <p class="e3"><span class="ok">✓</span>Aprovado</p>
    </div>
    <p class="rodape">Enviado pelo caixa</p>
  </div>
  <span class="leitor" aria-hidden="true"></span>
</div>

<style>
  .maquininha { --d: 6s; position: relative; aspect-ratio: 9 / 17; width: 100%; margin-top: 22%; padding: 9% 9% 20%; border-radius: 16% / 8%;
    background: linear-gradient(160deg, #3a3631, #1b1917 60%); box-shadow: 0 0 0 1px rgb(255 255 255 / .14), inset 0 1px 0 rgb(255 255 255 / .18), 0 30px 50px -20px rgb(0 0 0 / .9); container-type: inline-size; }
  /* Impressora em cima, mais larga que o corpo, com o comprovante saindo depois do "Aprovado". */
  .impressora { position: absolute; left: -3%; right: -3%; top: -14%; height: 17%; border-radius: 14% / 40%; z-index: 1;
    background: linear-gradient(180deg, #45403a, #24211e); box-shadow: 0 0 0 1px rgb(255 255 255 / .12), inset 0 1px 0 rgb(255 255 255 / .2); }
  .impressora::before { content: ''; position: absolute; left: 14%; right: 14%; top: 22%; height: 12%; border-radius: 99px; background: #0d0c0b; }
  .papel { position: absolute; left: 18%; right: 18%; bottom: 66%; z-index: -1; height: 0; background: repeating-linear-gradient(180deg, #fff 0 10%, #ecebe7 10% 14%); border-radius: 2px 2px 0 0; box-shadow: 0 -2px 6px rgb(0 0 0 / .25); animation: comprovante-sai var(--d) infinite; }
  @keyframes comprovante-sai { 0%, 64% { height: 0; } 84%, 96% { height: 160%; } 100% { height: 0; } }
  .leitor { position: absolute; bottom: 7%; left: 26%; right: 26%; height: 3.5%; border-radius: 99px; background: #0d0c0b; box-shadow: inset 0 1px 2px rgb(0 0 0 / .8); }
  .tela { height: 100%; border-radius: 6%; background: #f6f5f2; color: #1c1b19; display: grid; grid-template-rows: auto auto 1fr auto; align-items: center; justify-items: center; text-align: center; padding: 12% 8% 10%; overflow: hidden; }
  .topo { font-size: 7.5cqw; color: #6f6a62; }
  .valor { margin-top: 4%; font-size: 15cqw; font-weight: 700; letter-spacing: -0.03em; }
  .estados { position: relative; width: 100%; height: 100%; }
  .estados p { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 8%; font-size: 8cqw; font-weight: 600; opacity: 0; animation: var(--d) infinite; }
  .e1 { animation-name: e1 !important; }
  .e2 { animation-name: e2 !important; }
  .e3 { animation-name: e3 !important; color: #1f8f4e; }
  @keyframes e1 { 0%, 28% { opacity: 1; } 33%, 100% { opacity: 0; } }
  @keyframes e2 { 0%, 30% { opacity: 0; } 35%, 58% { opacity: 1; } 63%, 100% { opacity: 0; } }
  @keyframes e3 { 0%, 60% { opacity: 0; transform: scale(.8); } 66%, 96% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  .cartao { width: 30cqw; height: 19cqw; border-radius: 3cqw; background: linear-gradient(135deg, #f36812, #ffb547); animation: aproximar var(--d) infinite; }
  @keyframes aproximar { 0% { transform: translateY(12cqw) rotate(-8deg); opacity: 0; } 12%, 28% { transform: none; opacity: 1; } }
  .roda { width: 15cqw; height: 15cqw; border-radius: 50%; border: 2cqw solid #e2dfd9; border-top-color: #f36812; animation: girar .8s linear infinite; }
  @keyframes girar { to { transform: rotate(360deg); } }
  .ok { width: 19cqw; height: 19cqw; border-radius: 50%; display: grid; place-items: center; background: #1f8f4e; color: #fff; font-size: 10cqw; }
  .rodape { font-size: 6.5cqw; color: #8a857c; }
  @media (prefers-reduced-motion: reduce) {
    .estados p, .cartao, .roda, .papel { animation: none !important; }
    .e3 { opacity: 1; }
  }
</style>
