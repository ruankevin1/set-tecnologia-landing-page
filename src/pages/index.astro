---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Tela from '../components/Tela.astro';
import Icone from '../components/Icone.astro';
import Perguntas from '../components/Perguntas.astro';
import Formulario from '../components/Formulario.astro';
import Clientes from '../components/Clientes.astro';
import Video from '../components/Video.astro';
import TopoProduto from '../components/TopoProduto.astro';
import Composicao from '../components/Composicao.astro';
import Vantagens from '../components/Vantagens.astro';
import Estrelas from '../components/Estrelas.astro';
import CardapioAoVivo from '../components/CardapioAoVivo.astro';
import IconeModulo from '../components/IconeModulo.astro';
import TelasCelular from '../components/TelasCelular.astro';
import Impressos from '../components/Impressos.astro';
import Destaque from '../components/Destaque.astro';
import ConversaExemplo from '../components/ConversaExemplo.astro';
import { empresa } from '../data/empresa';
import { adquirentes } from '../data/maquininhas';

import balcao from '../assets/telas2/balcao.png';
import mesaPedido from '../assets/telas2/mesa-pedido.png';
import tablet from '../assets/telas2/tablet-cardapio.png';
import salao from '../assets/telas2/salao.png';
import contaPartes from '../assets/telas2/fechar-mesa-partes.png';
import contaTudo from '../assets/telas2/fechar-mesa-tudo.png';
import contaComanda from '../assets/telas2/fechar-mesa-comanda.png';
import contaDividir from '../assets/telas2/fechar-mesa-dividir.png';
import dividirItem from '../assets/telas2/zoom-dividir-item.png';
import delivery from '../assets/telas2/delivery-quadro.png';
import relatorios from '../assets/telas2/relatorios.png';
import cardapioPoster from '../assets/telas/catalogo-celular.png';
import tabletProduto from '../assets/telas2/tablet-produto.png';
import gMesas from '../assets/garcom/mesas.png';
import gAvisos from '../assets/garcom/avisos.png';
import gMesasClaro from '../assets/garcom/mesas-claro.png';
import gTransferirClaro from '../assets/garcom/transferir-claro.png';
import marca99 from '../assets/marcas/noventaenove_food.png';
import marcaIfood from '../assets/marcas/ifood.png';
const telasDoGarcom = [
  { src: gMesasClaro, alt: 'App do garçom no modo claro com as mesas do salão, o valor e as comandas de cada uma, a mesa 1 chamando e as mesas paradas', legenda: 'Mesas, comandas e quem chamou', modo: 'claro' },
  { src: gAvisos, alt: 'App do garçom no modo escuro com os avisos do salão: a mesa 1 chamou o garçom, com o botão Assumir, e as mesas sem pedido há mais tempo', legenda: 'Mesa chamou: o garçom assume o atendimento', modo: 'escuro' },
  { src: gTransferirClaro, alt: 'Transferir de Mesa 2, no modo claro: as duas caipirinhas marcadas, item por item, antes de escolher a mesa', legenda: 'Transferir só uma parte, item por item', modo: 'claro' },
];


// Abas do sistema: um print grande por vez, trocando sozinho enquanto a seção está na tela.
const modulos = [
  { id: 'balcao', nome: 'Balcão', icone: 'caixa', titulo: 'Venda de balcão em três toques', texto: 'Produto por foto, busca ou código. O que sai do prato vai junto no pedido. Sangria, suprimento e fechamento por operador.', img: balcao, alt: 'Tela Balcão do Set Tecnologia com chopp, bolinho de bacalhau sem salsinha e caipirinha somando R$ 98,00' },
  { id: 'salao', nome: 'Salão', icone: 'salao', titulo: 'O salão inteiro numa tela', texto: 'Valor em aberto, comandas e há quanto tempo cada mesa está aberta.', img: salao, alt: 'Mapa do salão com as mesas 1, 4 e 7 ocupadas e R$ 265,00 em aberto' },
  { id: 'garcom', nome: 'Garçom', icone: 'garcom', titulo: 'O salão no celular do garçom', texto: 'Mesas, chamados das mesas, pedido, transferência e atendimento avulso pelo celular, sem voltar ao caixa. Modo claro ou escuro, como o garçom preferir.', celulares: true },
  { id: 'mesa', nome: 'Pedido na mesa', icone: 'comanda', titulo: 'Cada pessoa com a sua comanda', texto: 'O que foi retirado e a observação saem impressos no setor certo da cozinha, sem redigitar.', img: mesaPedido, alt: 'Pedido da mesa 1 lançado na comanda 7, com carpaccio sem alcaparras e observação para a cozinha' },
  { id: 'tablet', nome: 'Tablet de mesa', icone: 'tablet', titulo: 'O cliente pede pela mesa', texto: 'Cardápio com fotos, ponto da carne e chamada do garçom. O pedido entra direto na conta da mesa.', img: tablet, alt: 'Tablet de mesa do Set Tecnologia com o cardápio de pratos com fotos, na mesa 4', tipo: 'tablet' },
  { id: 'conta', nome: 'Conta dividida', icone: 'dividir', titulo: 'Cada um paga o que consumiu', texto: 'Até um terço da calabresa. A conta fecha no centavo, e com Smart TEF o valor vai direto para a maquininha.', img: contaPartes, alt: 'Pagamento da mesa 1 com um chopp e um terço da calabresa marcados, R$ 24,67 a receber' },
  { id: 'delivery', nome: 'Delivery', icone: 'delivery', titulo: 'Todos os pedidos no mesmo quadro', texto: 'Telefone, WhatsApp, cardápio online, 99Food e iFood: aceito, preparo, pronto, saiu e entregue. A Eduarda, atendimento com IA no WhatsApp, manda o pedido direto para o delivery próprio.', img: delivery, alt: 'Quadro do Delivery com pedidos do 99Food e do telefone: um novo do 99Food com o prazo para aceitar, outros em Aceito, Preparo e Pronto' },
  { id: 'relatorios', nome: 'Relatórios', icone: 'relatorios', titulo: 'O dia fechado em números', texto: 'Faturamento, vendas por produto e por operador, acerto dos motoboys, repasses do 99Food e o XML do contador.', img: relatorios, alt: 'Tela de Relatórios com o resumo de hoje, relatórios comerciais, de delivery e repasses do 99Food' },
] as const;

const recursos = [
  { icone: 'garcom', t: 'Garçom no celular', d: 'Lança o pedido na mesa e ele sai impresso na cozinha e no bar.' },
  { icone: 'tablet', t: 'Tablet de mesa', d: 'O cliente pede, marca o ponto e chama o garçom pela tela.' },
  { icone: 'impressora', t: 'Impressão por setor', d: 'Cozinha, bar e pizzaria recebem só o que é deles.' },
  { icone: 'comanda', t: 'Comandas e cartões', d: 'Uma comanda por pessoa, com cartão numerado.' },
  { icone: 'estoque', t: 'Estoque', d: 'Baixa pela venda e aviso de estoque baixo no caixa.' },
  { icone: 'motoboy', t: 'Motoboys', d: 'Entrega por motoboy e o acerto de cada um no fechamento do dia.' },
  { icone: 'nfce', t: 'NFC-e', d: 'Nota no fechamento, contingência e XML pronto para o contador.' },
  { icone: 'rede', t: 'Funciona sem internet', d: 'Caixa, tablets e celulares conversam pela rede da própria loja.' },
] as const;

const integracoes = [
  { marca: marca99, nome: '99Food', d: 'Pedidos do aplicativo no quadro do delivery, com cardápio, produtos e adicionais enviados pelo Set.' },
  { marca: marcaIfood, nome: 'iFood', d: 'Pedidos do aplicativo no quadro do delivery, com o cardápio enviado pelo Set.' },
  { icone: 'whatsapp', cor: '#1f8f4e', nome: 'WhatsApp', d: 'Eduarda, o atendimento com IA da loja: responde cardápio, preços e taxa e manda o pedido direto para o delivery próprio.' },
  { icone: 'tef', cor: '#f36812', nome: 'Smart TEF', d: 'O valor vai do caixa para a maquininha smart e a venda fecha sozinha quando o pagamento é aprovado.' },
  { icone: 'nfce', cor: '#2f7d4f', nome: 'SEFAZ', d: 'NFC-e autorizada direto com a SEFAZ, com contingência quando a internet cai.' },
  { icone: 'cardapio', cor: '#3b6fd8', nome: 'Cardápio online', d: 'Delivery próprio no celular do cliente, com o pedido entrando no caixa.' },
  { icone: 'impressora', cor: '#5b5650', nome: 'Impressoras térmicas', d: 'Em rede ou USB, uma por setor, aproveitando as que a loja já tem.' },
  { icone: 'maquininha', cor: '#8a5cf6', nome: 'Adquirentes', d: 'Rede, Cielo, Getnet, Stone, PagBank, Mercado Pago, Sicredi e praticamente todas as outras pelo Smart TEF.' },
] as const;

const formasDeConta = [
  { id: 'partes', nome: 'Item em partes', texto: 'Uma porção dividida em quantas partes precisar. Cada parte é paga por quem consumiu, e a soma fecha no centavo.', img: dividirItem, alt: 'Janela Dividir item com a calabresa acebolada sendo dividida em 3 partes' },
  { id: 'marcar', nome: 'Por item ou comanda', texto: 'Marca a comanda inteira ou só os itens de cada pessoa. O restante continua aberto na mesa.', img: contaComanda, alt: 'Pagamento da mesa 1 com a comanda 3 inteira marcada, R$ 89,00 a receber' },
  { id: 'igual', nome: 'Igual entre pessoas', texto: 'Escolhe quantas pessoas e o sistema divide o total. R$ 179,00 entre três dá R$ 59,67 para cada.', img: contaDividir, alt: 'Pagamento da mesa 1 dividido entre 3 pessoas, R$ 59,67 a receber' },
  { id: 'tudo', nome: 'A conta inteira', texto: 'Todas as comandas da mesa juntas, com dinheiro, cartão, Pix ou as formas misturadas.', img: contaTudo, alt: 'Pagamento da mesa 1 com as comandas 3 e 7 e R$ 179,00 a receber' },
];

const antes = ['Comanda de papel e pedido gritado na cozinha', 'Conta da mesa somada na calculadora', 'Valor digitado de novo na maquininha', 'Delivery pelo WhatsApp, anotado à mão', 'Comissão em cada pedido do aplicativo', 'Fechamento de caixa no caderno'];
const depois = ['Pedido do celular do garçom sai impresso no setor certo', 'Conta dividida por pessoa, item ou partes iguais', 'Smart TEF manda o valor direto para a maquininha', 'Pedidos do site, do 99Food e do iFood no mesmo quadro', 'Cardápio online próprio, sem comissão', 'Relatório de caixa, vendas e notas no fim do dia'];

const produtos = [
  { n: '01', nome: 'Set Tecnologia', href: '/sistema-para-restaurante', texto: 'Sistema próprio para restaurante, bar e lanchonete: caixa, salão, garçom no celular, tablet de mesa, cozinha, estoque e NFC-e.', para: 'Restaurantes com salão e cozinha' },
  { n: '02', nome: 'Cardápio digital e delivery', href: '/cardapio-digital-e-delivery', texto: 'Cardápio online com endereço próprio da loja, sem comissão por pedido. Integração com 99Food e iFood e Eduarda, o atendimento com IA no WhatsApp, com pedido direto no delivery próprio.', para: 'Quem entrega ou faz retirada' },
  { n: '03', nome: 'Smart TEF', href: '/smart-tef', texto: 'Pagamento na maquininha smart integrado ao caixa, com as principais adquirentes do mercado.', para: 'Caixa com fila' },
  { n: '04', nome: 'PDV+', href: empresa.pdvPlus, texto: 'PDV em planos mensais que roda no celular, no tablet e no PC, com NFC-e. Sem fidelidade.', para: 'MEI e comércio de balcão' },
];

const etapas = [
  { t: 'Diagnóstico', d: 'Visita ou chamada para entender salão, cozinha, delivery, caixas e situação fiscal.' },
  { t: 'Cadastro', d: 'Cardápio com fotos, grupos, complementos e tributação de cada produto, certificado digital e CSC da NFC-e.' },
  { t: 'Instalação', d: 'Caixa, servidor da loja, impressoras da cozinha e do bar, tablets de mesa e celulares dos garçons.' },
  { t: 'Treinamento', d: 'Caixa, garçons e cozinha, no horário de menor movimento, com a operação real.' },
  { t: 'Suporte', d: 'WhatsApp e acesso remoto direto com quem fez a implantação. Visita quando o problema pede.' },
];


const perguntas = [
  { p: 'Quanto custa?', r: 'O valor depende do número de caixas, dos dispositivos e dos módulos (delivery próprio, Smart TEF, 99Food, iFood e atendimento com IA). O orçamento sai na primeira conversa, já com a configuração indicada para a operação.' },
  { p: 'Preciso trocar computador e impressoras?', r: 'Na maioria dos casos, não. O caixa roda em computador com Windows, os tablets de mesa são Android e as impressoras térmicas em rede ou USB são aproveitadas. A avaliação dos equipamentos faz parte do diagnóstico.' },
  { p: 'O sistema para quando a internet cai?', r: 'Não. Caixa, tablets e celulares dos garçons conversam pela rede da própria loja. As vendas continuam e as notas emitidas em contingência são transmitidas quando a conexão volta.' },
  { p: 'Funciona com a minha maquininha?', r: 'Pelo Smart TEF, o Set funciona com as maquininhas smart de Rede, Cielo, Getnet, Stone, PagBank, Mercado Pago, SafraPay, Vero, Sipag, Sicredi, Caixa, BIN, PicPay e outras. A lista de modelos está na página do Smart TEF.' },
  { p: 'Recebe pedidos do 99Food e do iFood?', r: 'Sim. Os pedidos do 99Food e do iFood entram no quadro de delivery do caixa junto com os do cardápio online, com aceite, preparo e entrega acompanhados no sistema.' },
  { p: 'Emite nota fiscal?', r: 'Sim. A NFC-e é emitida no fechamento da venda, com a configuração fiscal feita na implantação. Os relatórios mostram notas autorizadas, canceladas e pendentes, e o XML sai pronto para o contador.' },
  { p: 'Atendem fora do Rio Grande do Sul?', r: 'Sim. A Set atende todo o Rio Grande do Sul. Fora do estado, a implantação e o treinamento são feitos a distância, com o mesmo suporte por WhatsApp e acesso remoto.' },
];

const faqDados = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: perguntas.map((q) => ({ '@type': 'Question', name: q.p, acceptedAnswer: { '@type': 'Answer', text: q.r } })),
};
---
<Base
  titulo="Sistema para restaurante no Rio Grande do Sul | Set Tecnologia"
  descricao="Sistema para restaurante intuitivo e prático: caixa, garçom no celular, delivery sem comissão, Smart TEF e NFC-e. Implantação e suporte em todo o RS."
  dados={[faqDados]}
>
  <!-- Topo -->
  <TopoProduto
    rotulo="Sistema para restaurante · Todo o Rio Grande do Sul"
    titulo="Sistema para restaurante completo, <em>do salão ao delivery.</em>"
    texto="Intuitivo e prático: caixa, garçom no celular, tablet de mesa, cozinha, delivery, 99Food, iFood, Smart TEF e NFC-e no mesmo sistema. Desenvolvido, implantado e mantido pela Set Tecnologia."
    selos={[
      { icone: 'garcom', t: 'Garçom no celular' },
      { icone: 'dinheiro', t: 'Delivery sem comissão' },
      { icone: 'tef', t: 'Smart TEF na maquininha' },
      { icone: 'rede', t: 'Funciona sem internet' },
    ]}
  >
    <div class="vitrine-topo"><Composicao vitrine prioridade principal={balcao} altPrincipal="Tela Balcão do Set Tecnologia com grade de produtos e venda em andamento" tablet={tabletProduto} altTablet="Tablet de mesa com o Filé à parmegiana e as etapas Retirar, Ponto da carne e Observação" celular={cardapioPoster} altCelular="Cardápio online do delivery no celular do cliente" garcom={gMesas} altGarcom="App do garçom no celular com as mesas do salão" /></div>
  </TopoProduto>

  <Clientes />

  <Vantagens
    titulo="Intuitivo e prático, <em>do primeiro dia.</em>"
    texto="Feito para a correria do restaurante: quem está no caixa, no salão ou na cozinha entende a tela sem manual."
    itens={[
      { icone: 'check', t: 'Intuitivo', d: 'Produtos com foto, botões grandes e textos claros. O garçom aprende no treinamento da implantação.' },
      { icone: 'raio', t: 'Prático', d: 'Poucos toques do pedido ao fechamento: lança, imprime na cozinha, divide a conta e cobra.' },
      { icone: 'caixa', t: 'Tudo num lugar', d: 'Caixa, salão, delivery, 99Food, iFood, maquininha e nota fiscal no mesmo sistema, sem trocar de tela.' },
    ]}
  />

  <!-- O sistema por dentro -->
  <section class="sistema" id="sistema" aria-labelledby="sistema-titulo">
    <div class="envelope">
      <div class="cabeca centro" data-revelar>
        <p class="rotulo">O sistema por dentro</p>
        <h2 id="sistema-titulo" class="titulo-secao">Telas reais, do caixa ao relatório.</h2>
      </div>
      <div class="modulos" data-modulos data-revelar>
        <div class="trilha-abas" role="tablist" aria-label="Módulos do sistema">
          {modulos.map((m, i) => (
            <button type="button" role="tab" data-luz id={`mod-${m.id}`} aria-controls={`painel-mod-${m.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              <span class="aba-ico"><IconeModulo nome={m.icone} /></span>
              <span>{m.nome}</span>
              <span class="progresso" aria-hidden="true"></span>
            </button>
          ))}
        </div>
        <div class="palco">
          <div class="aura" aria-hidden="true"></div>
          {modulos.map((m, i) => (
            <div class="painel" role="tabpanel" id={`painel-mod-${m.id}`} aria-labelledby={`mod-${m.id}`} hidden={i !== 0}>
              <div class="painel-texto"><h3>{m.titulo}</h3><p>{m.texto}</p></div>
              {'celulares' in m ? (
                <div class="painel-tela"><TelasCelular telas={telasDoGarcom} /></div>
              ) : (
                <div class:list={['painel-tela', { estreita: 'tipo' in m }]}>
                  <Tela src={m.img} alt={m.alt} tipo={'tipo' in m ? m.tipo : 'janela'} prioridade={i === 0} />
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Formas de fechar a conta -->
  <section class="conta envelope" aria-labelledby="conta-titulo">
    <div class="cabeca centro" data-revelar>
      <p class="rotulo">Fechamento da mesa</p>
      <h2 id="conta-titulo" class="titulo-secao">Fechar a conta do jeito que a mesa quer.</h2>
      <p class="lead">Quatro formas no mesmo caixa, que podem ser misturadas na mesma conta.</p>
    </div>
    <div class="conta-grade" data-abas data-revelar>
      <div class="abas" role="tablist" aria-label="Formas de fechar a conta">
        {formasDeConta.map((f, i) => (
          <button type="button" role="tab" data-luz id={`aba-${f.id}`} aria-controls={`painel-${f.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <span class="aba-nome">{f.nome}</span>
            <span class="aba-texto">{f.texto}</span>
          </button>
        ))}
      </div>
      <div class="paineis">
        {formasDeConta.map((f, i) => (
          <div role="tabpanel" id={`painel-${f.id}`} aria-labelledby={`aba-${f.id}`} hidden={i !== 0}>
            <Tela src={f.img} alt={f.alt} larguras={[960, 1440]} sizes="(max-width: 1000px) 100vw, 800px" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="impressos-secao envelope" aria-labelledby="impressos-titulo-inicio">
    <div class="cab-impressos" data-revelar>
      <p class="rotulo">Impressos</p>
      <h2 id="impressos-titulo-inicio" class="titulo-secao">Cada papel <em>no lugar certo.</em></h2>
      <p class="lead">Pedido na cozinha, chamado da mesa, conta, fechamento de caixa, acerto do motoboy e nota fiscal: tudo sai impresso pelo próprio Set, legível e sem redigitar.</p>
    </div>
    <Impressos />
  </section>

  <!-- Cardápio online -->
  <section class="cardapio" aria-labelledby="cardapio-titulo">
    <div class="envelope cardapio-grade">
      <div data-revelar>
        <p class="rotulo">Cardápio online</p>
        <h2 id="cardapio-titulo" class="titulo-secao">O delivery da loja, <span class="gradiente">sem comissão.</span></h2>
        <p class="lead">Um cardápio que funciona como o feed do Instagram: fotos grandes, categorias em bolinhas como os stories e destaques deslizando. O pedido entra direto no caixa e sai impresso na cozinha. Role o cardápio ao lado: é o sistema funcionando.</p>
        <ul class="selos-cardapio">
          <li>0% de comissão</li><li>Pedido direto no caixa</li><li>99Food e iFood no mesmo quadro</li><li>Sem aplicativo para baixar</li>
        </ul>
        <div class="acoes">
          <a class="botao botao-principal" href="#contato">Falar com especialista <Icone nome="seta" /></a>
          <a class="botao botao-linha" href="/cardapio-digital-e-delivery">Ver como funciona</a>
        </div>
      </div>
      <div class="cardapio-palco" data-revelar style="--atraso:.1s">
        <div class="aura" aria-hidden="true"></div>
        <CardapioAoVivo poster={cardapioPoster} alt="Cardápio online do Reis Restaurante no celular, com destaque e grupos do cardápio" />
        <div class="flutua f1" aria-hidden="true"><span class="f-ico"><IconeModulo nome="caixa" /></span><span><b>Pedido #128</b>entrou no caixa</span></div>
        <div class="flutua f2" aria-hidden="true"><span class="f-ico"><IconeModulo nome="impressora" /></span><span><b>Cozinha</b>pedido impresso</span></div>
        <div class="flutua f3" aria-hidden="true"><span class="f-ico"><IconeModulo nome="motoboy" /></span><span><b>Saiu para entrega</b>com o motoboy</span></div>
      </div>
    </div>
  </section>

  <!-- Atendimento com IA -->
  <Destaque
    rotulo="Atendimento com IA · WhatsApp da loja"
    titulo="Atendimento com IA <em>no WhatsApp da loja.</em>"
    texto="A loja conecta o próprio número pelo sistema Set Tecnologia. A IA responde sobre cardápio, preços e taxa de entrega, tira o pedido e passa a conversa para uma pessoa da loja quando o cliente pede."
    pontos={['Preços e taxas saem do sistema da loja', 'O pedido só segue para a loja depois da confirmação do cliente']}
    acao={{ texto: 'Ver como funciona', href: '/atendimento-com-ia-no-whatsapp' }}
    invertido
  >
    <ConversaExemplo />
  </Destaque>

  <!-- Recursos -->
  <section class="recursos envelope" aria-labelledby="recursos-titulo">
    <div class="cabeca centro" data-revelar>
      <p class="rotulo">Recursos</p>
      <h2 id="recursos-titulo" class="titulo-secao">Tudo o que a operação precisa, num lugar só.</h2>
    </div>
    <ul class="grade-recursos">
      {recursos.map((r, i) => (
        <li class="recurso" data-luz data-revelar style={`--atraso:${(i % 4) * 0.06}s`}>
          <span class="r-ico"><IconeModulo nome={r.icone} /></span>
          <h3>{r.t}</h3>
          <p>{r.d}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Integrações -->
  <section class="integracoes envelope" aria-labelledby="integ-titulo">
    <div class="cabeca centro" data-revelar>
      <p class="rotulo">Integrações</p>
      <h2 id="integ-titulo" class="titulo-secao">Conectado ao que a loja já usa.</h2>
      <p class="lead">Aplicativos de entrega, WhatsApp, maquininha, SEFAZ e impressoras ligados ao mesmo caixa.</p>
    </div>
    <ul class="grade-integ">
      {integracoes.map((g, i) => (
