<script>
  // Abas com teclado (setas) e clique. As do sistema trocam sozinhas enquanto estão na tela.
  const montarAbas = (g: HTMLElement, sozinho: boolean) => {
    const abas = [...g.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    let atual = 0, timer = 0;
    const DURACAO = 6000;
    const reiniciar = () => {
      clearTimeout(timer);
      g.classList.remove('correndo'); void g.offsetWidth;
      if (!g.dataset.parado && g.dataset.visivel) { g.classList.add('correndo'); timer = window.setTimeout(() => ativar((atual + 1) % abas.length), DURACAO); }
    };
    const ativar = (i: number, foco = false) => {
      atual = i;
      abas.forEach((x, k) => {
        const sim = k === i;
        x.setAttribute('aria-selected', String(sim)); x.tabIndex = sim ? 0 : -1;
        const painel = g.querySelector<HTMLElement>('#' + x.getAttribute('aria-controls'))!;
        painel.hidden = !sim;
        if (sim) { painel.classList.remove('troca'); void painel.offsetWidth; painel.classList.add('troca'); }
      });
      if (foco) abas[i].focus();
      if (sozinho) reiniciar();
    };
    abas.forEach((a, i) => {
      a.addEventListener('click', () => { g.dataset.parado = '1'; ativar(i); });
      a.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return; e.preventDefault(); g.dataset.parado = '1';
        ativar((i + d + abas.length) % abas.length, true);
      });
    });
    if (sozinho && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      g.style.setProperty('--duracao', `${DURACAO}ms`);
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting) g.dataset.visivel = '1'; else delete g.dataset.visivel;
        reiniciar();
      }, { threshold: .35 }).observe(g);
    }
  };
  document.querySelectorAll<HTMLElement>('[data-modulos]').forEach((g) => montarAbas(g, true));
  document.querySelectorAll<HTMLElement>('[data-abas]').forEach((g) => montarAbas(g, false));

  // Antes e depois: o controle deslizante move a divisória.
  document.querySelectorAll<HTMLElement>('[data-comparar]').forEach((caixa) => {
    const r = caixa.querySelector('input')!;
    const mover = () => caixa.style.setProperty('--pos', `${r.value}%`);
    r.addEventListener('input', mover);
    // Um aceno quando entra na tela, para mostrar que dá para arrastar.
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      io.disconnect();
      const t0 = performance.now();
      const f = (t: number) => {
        const k = Math.min(1, (t - t0) / 1600);
        r.value = String(50 + Math.sin(k * Math.PI * 2) * 18 * (1 - k)); mover();
        if (k < 1) requestAnimationFrame(f);
      };
      requestAnimationFrame(f);
    }, { threshold: .6 });
    io.observe(caixa);
  });
</script>

